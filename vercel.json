{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/mishkat?path=$1" },
    { "source": "/", "destination": "/mishkat/public/index.html" },
    { "source": "/index.html", "destination": "/mishkat/public/index.html" },
    { "source": "/app.js", "destination": "/mishkat/public/app.js" },
    { "source": "/style.css", "destination": "/mishkat/public/style.css" },
    { "source": "/assets/(.*)", "destination": "/mishkat/public/assets/$1" }
  ],
  "functions": {
    "api/mishkat.js": {
      "maxDuration": 60,
      "includeFiles": "mishkat/data/**"
    }
  }
}
