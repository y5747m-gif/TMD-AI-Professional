# ==========================================================================
#  مشكاة (Mishkat) — نموذج متغيرات البيئة
#  انسخ هذا الملف إلى  mishkat/.env  أو  .env  ثم عدّل القيم.
#  (الخادم يقرأ .env تلقائيًا بلا أي مكتبة خارجية)
# ==========================================================================

# -------------------------------- القناة المعتمدة -------------------------
# معرّف القناة على يوتيوب (ثابت في هذه الأداة):
YOUTUBE_CHANNEL_ID=UCv0g_v1C6JcZALvrkDu98AQ
YOUTUBE_CHANNEL_URL=https://youtube.com/channel/UCv0g_v1C6JcZALvrkDu98AQ

# مفتاح YouTube Data API v3 (اختياري — يسرّع السرد ويجلب التفاصيل بدقة).
# بدون مفتاح: يتم سرد الفيديوهات وسحب النصوص بالاستخراج المباشر.
YOUTUBE_API_KEY=

# --------------------------- محرك الذكاء الاصطناعي ------------------------
# اختر مزوّدًا واحدًا على الأقل. الأداة تعمل بمحرك استخراجي (بدون مفتاح) إن غاب الكل.
# auto = أول مفتاح متاح | gemini | groq | openai | openrouter | custom | off
MISHKAT_AI_MODE=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# مزوّد مخصّص متوافق مع OpenAI (مثلًا خادم محلي أو خدمة عربية)
MISHKAT_LLM_BASE_URL=
MISHKAT_LLM_API_KEY=
MISHKAT_LLM_MODEL=

MISHKAT_TEMPERATURE=0.2
MISHKAT_MAX_TOKENS=2048
MISHKAT_CONTEXT_CHARS=14000
MISHKAT_AI_TIMEOUT_MS=60000

# ------------------------------- الخادم -----------------------------------
PORT=3000
MISHKAT_HOST=0.0.0.0
# كلمة مرور لوحة الإدارة/التغذية (اتركها فارغة في التطوير المحلي فقط)
MISHKAT_ADMIN_TOKEN=
MISHKAT_NAME=مشكاة
MISHKAT_DEFAULT_MODE=balanced

# --------------------------- قاعدة البيانات والبحث ------------------------
# مسارات اختيارية (الافتراضي: mishkat/data)
MISHKAT_DATA_DIR=
MISHKAT_DB_PATH=
MISHKAT_JSON_INDEX=
# json = إجبار المتجر البديل (بدون SQLite) — يُستخدم تلقائيًا على Vercel
MISHKAT_STORE=

MISHKAT_TOP_K=8
MISHKAT_MAX_PER_VIDEO=3
MISHKAT_MIN_SCORE=0.02
MISHKAT_CHUNK_CHARS=700

# ------------------------------ السحب (Ingest) ----------------------------
# 0 = كل فيديوهات القناة
MISHKAT_MAX_VIDEOS=0
MISHKAT_INGEST_DELAY_MS=350
MISHKAT_INGEST_RETRIES=3
# استخدام yt-dlp كبديل عند تعذّر الترجمة (يتطلب تثبيت yt-dlp)
MISHKAT_USE_YTDLP=false

# للتشخيص المفصّل
MISHKAT_DEBUG=
