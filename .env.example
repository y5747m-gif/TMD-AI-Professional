# ==========================================================================
#  مشكاة (Mishkat) — نموذج متغيرات البيئة
#  انسخ هذا الملف إلى  mishkat/.env  أو  .env  ثم عدّل القيم.
#  (الخادم يقرأ .env تلقائيًا بلا أي مكتبة خارجية)
#
#  مبدأ الأداة:
#    • الردود تُجلب لحظيًا من موقع إسلام ويب (فتاوى/استشارات/مقالات).
#    • الفيديوهات تُعرَض كروابط فقط (عنوان + رابط) — بلا أي نسخ كامل للنصوص.
# ==========================================================================

# --------------------------- مصدر الردود: إسلام ويب -----------------------
ISLAMWEB_ENABLED=true
# auto   = اتصال مباشر، وإن فشل (حجب/مهلة) يُستعمل قارئ الصفحات
# direct = اتصال مباشر فقط | reader = قارئ الصفحات فقط | off = تعطيل الموصّل
ISLAMWEB_MODE=auto
ISLAMWEB_BASE=https://www.islamweb.net

# قارئ احتياطي للصفحات يعمل بلا مفتاح (يُستعمل عند حجب الاتصال المباشر)
ISLAMWEB_READER_FALLBACK=true
ISLAMWEB_READER_BASE=https://r.jina.ai/

ISLAMWEB_TIMEOUT_MS=12000
ISLAMWEB_READER_TIMEOUT_MS=30000

# عدد النتائج المعروضة، وعدد الفتاوى التي يُجلب نصّها الكامل
ISLAMWEB_TOP_K=6
ISLAMWEB_FULL_DOCS=2
ISLAMWEB_MAX_ANSWER_CHARS=6000

# مدة الاحتفاظ بالصفحات في الذاكرة المؤقتة (بالدقائق صفر = تعطيل)
ISLAMWEB_CACHE_TTL_MINUTES=720

# الأقسام المستخدمة كمصدر للرد
ISLAMWEB_SECTION_FATWA=true
ISLAMWEB_SECTION_CONSULT=true
ISLAMWEB_SECTION_ARTICLE=true

# --------------------------- محرك الذكاء الاصطناعي ------------------------
# اختياري تمامًا: بدونه تعمل الأداة بـ«المحرك الناقل» (نقل نصّ الجواب كما هو).
# auto = أول مفتاح متاح | gemini | groq | openai | openrouter | custom | off
MISHKAT_AI_MODE=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# مزوّد مخصّص متوافق مع OpenAI
MISHKAT_LLM_BASE_URL=
MISHKAT_LLM_API_KEY=
MISHKAT_LLM_MODEL=

MISHKAT_TEMPERATURE=0.15
MISHKAT_MAX_TOKENS=2048
MISHKAT_CONTEXT_CHARS=16000
MISHKAT_AI_TIMEOUT_MS=60000
# ترتيب نتائج إسلام ويب بالذكاء الاصطناعي (يعمل عند وجود مفتاح)
MISHKAT_AI_RERANK=true
# صياغة الرد بالذكاء الاصطناعي (وإلا فالعرض منقول كما هو)
MISHKAT_AI_COMPOSE=true

# ------------------------------- الفيديوهات --------------------------------
# لائحة روابط الفيديوهات (عنوان + رابط فقط)
MISHKAT_VIDEOS_PATH=
MISHKAT_VIDEOS_TOP_K=5
# أدنى درجة ملاءمة لاعتبار الفيديو مرتبطًا بالسؤال (0..1)
MISHKAT_VIDEOS_MIN_SCORE=0.28
# جلب عنوان الفيديو تلقائيًا عند إضافته بالرابط
MISHKAT_VIDEO_OEMBED=true
# القناة المعتمدة (لعرضها في الواجهة)
YOUTUBE_CHANNEL_ID=UCv0g_v1C6JcZALvrkDu98AQ
YOUTUBE_CHANNEL_URL=https://youtube.com/channel/UCv0g_v1C6JcZALvrkDu98AQ

# ------------------------------- الخادم ------------------------------------
PORT=3000
MISHKAT_HOST=0.0.0.0
# كلمة مرور لوحة الإدارة/إضافة الفيديوهات (اتركها فارغة في التطوير المحلي فقط)
MISHKAT_ADMIN_TOKEN=
MISHKAT_NAME=مشكاة
# الوضع الافتراضي: sources (نقل كما هو من إسلام ويب) | composed (صياغة منظّمة بمفتاح ذكاء)
MISHKAT_DEFAULT_MODE=sources

# --------------------------- البيانات والتشخيص ------------------------------
MISHKAT_DATA_DIR=
MISHKAT_CACHE_DIR=
MISHKAT_DEBUG=
