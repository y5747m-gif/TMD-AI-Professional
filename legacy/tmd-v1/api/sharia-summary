"use strict";

const CHANNEL_ID = "UCv0g_v1C6JcZALvrkDu98AQ";
const GROQ_URL = "https://api.groq.com/openai/v1/chat/completions";
const MODEL = process.env.GROQ_SUMMARY_MODEL || "openai/gpt-oss-120b";

function xmlDecode(value) {
  return String(value || "")
    .replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"').replace(/&#39;/g, "'");
}
function cleanText(value) {
  return xmlDecode(value).replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
}
function chunkText(text, max = 24000) {
  const value = String(text || "");
  return value.length <= max ? value : value.slice(0, max) + "\n[تم اختصار نص الإدخال بسبب حد الطلب]";
}

async function verifyVideo(videoId) {
  const key = process.env.YOUTUBE_API_KEY;
  if (!key) throw new Error("YOUTUBE_API_KEY غير مضبوط في Vercel.");
  const url = new URL("https://www.googleapis.com/youtube/v3/videos");
  url.searchParams.set("part", "snippet");
  url.searchParams.set("id", videoId);
  url.searchParams.set("key", key);
  const r = await fetch(url.toString());
  const d = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(d?.error?.message || "تعذر التحقق من الفيديو.");
  const item = d?.items?.[0];
  if (!item || item?.snippet?.channelId !== CHANNEL_ID) return false;
  return true;
}

async function getCaptionTrack(videoId) {
  const response = await fetch("https://www.youtube.com/youtubei/v1/player?prettyPrint=false", {
    method: "POST",
    headers: { "Content-Type": "application/json", "User-Agent": "Mozilla/5.0" },
    body: JSON.stringify({
      context: { client: { clientName: "WEB", clientVersion: "2.20260901.01.00" } },
      videoId
    })
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) return null;
  const tracks = data?.captions?.playerCaptionsTracklistRenderer?.captionTracks;
  if (!Array.isArray(tracks) || !tracks.length) return null;
  return tracks.find(t => String(t.languageCode || "").startsWith("ar")) || tracks[0];
}

async function getTranscript(videoId) {
  const track = await getCaptionTrack(videoId);
  if (!track?.baseUrl) return null;
  const url = new URL(track.baseUrl);
  url.searchParams.set("fmt", "srv3");
  const response = await fetch(url.toString(), { headers: { "User-Agent": "Mozilla/5.0" } });
  if (!response.ok) return null;
  const xml = await response.text();
  const parts = [...xml.matchAll(/<text[^>]*>([\s\S]*?)<\/text>/gi)]
    .map(m => cleanText(m[1])).filter(Boolean);
  return parts.length ? parts.join(" ") : null;
}

async function summarizeTranscript(transcript) {
  const apiKey = process.env.GROQ_API_KEY;
  if (!apiKey) throw new Error("GROQ_API_KEY غير مضبوط في Vercel.");
  const prompt = `لخص نص الفيديو التالي فقط، فهو النص المستخرج من الفيديو نفسه.
قواعد صارمة:
- لا تستخدم أي معرفة خارج النص.
- لا تضف معلومات غير موجودة.
- لا تلخص عنوان الفيديو أو وصفه بدل النص.
- اجعل الملخص بالعربية ومقتصرًا على المعلومات التي وردت في نص الفيديو فقط.
- لا تضف حكمًا أو نصيحة أو معلومة من خارج النص.
- إذا كان النص غير مكتمل أو لا يكفي للإجابة عن السؤال، لا تخترع ما ينقصه.

نص الفيديو:
${chunkText(transcript)}`;
  const response = await fetch(GROQ_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json", "Authorization": `Bearer ${apiKey}` },
    body: JSON.stringify({ model: MODEL, temperature: 0.1, messages: [
      { role: "system", content: "أنت تلخص النص المرفق فقط دون اختلاق." },
      { role: "user", content: prompt }
    ] })
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data?.error?.message || "فشل تلخيص نص الفيديو.");
  return data?.choices?.[0]?.message?.content?.trim() || null;
}

module.exports = async function handler(req, res) {
  res.setHeader("Cache-Control", "no-store");
  res.setHeader("Content-Type", "application/json; charset=utf-8");
  if (req.method !== "POST") return res.status(405).json({ ok: false, error: "Method Not Allowed" });
  try {
    const body = typeof req.body === "string" ? JSON.parse(req.body || "{}") : (req.body || {});
    const videoId = String(body.videoId || "").trim();
    if (!videoId) return res.status(400).json({ ok: false, error: "videoId مطلوب" });

    // تحقق فعلي من YouTube API: لا نثق بأي channelId قادم من المتصفح.
    if (!(await verifyVideo(videoId))) {
      return res.status(403).json({ ok: false, error: "الفيديو ليس من القناة الشرعية المحددة." });
    }

    const transcript = await getTranscript(videoId);
    if (!transcript) return res.status(200).json({ ok: false });

    const summary = await summarizeTranscript(transcript);
    if (!summary) return res.status(200).json({ ok: false });
    return res.status(200).json({ ok: true, summary, channelId: CHANNEL_ID, videoId });
  } catch (error) {
    console.error("sharia-summary error:", error);
    return res.status(500).json({ ok: false, error: error?.message || "تعذر تلخيص الفيديو." });
  }
};
