{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/mishkat/public/index.html" },
    { "source": "/index.html", "destination": "/mishkat/public/index.html" },
    { "source": "/app.js", "destination": "/mishkat/public/app.js" },
    { "source": "/style.css", "destination": "/mishkat/public/style.css" },
    { "source": "/favicon.ico", "destination": "/mishkat/public/favicon.ico" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "mishkat/data/**"
    }
  }
}
